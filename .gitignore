# ============================================================
# .gitignore — Tells Git which files to IGNORE (not upload).
# ============================================================
# We don't want to upload compiled files, IDE settings,
# or sensitive data to GitHub.
# ============================================================

# --- Compiled Java output ---
target/

# --- IDE settings (IntelliJ IDEA) ---
.idea/
*.iml
*.iws
*.ipr

# --- IDE settings (VS Code) ---
.vscode/

# --- IDE settings (Eclipse) ---
.classpath
.project
.settings/

# --- OS generated files ---
.DS_Store
Thumbs.db

# --- Maven wrapper (if used) ---
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- Logs ---
*.log

# --- Environment / secret files ---
.env
